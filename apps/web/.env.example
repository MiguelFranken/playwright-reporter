# Postgres (pooled URL for the app, direct URL for migrations)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# Public URL of this app. Used for run links, trace-viewer URLs and as Better
# Auth's baseURL (cookies and CSRF), so it must be the real public origin.
BASE_URL=http://localhost:3000

# Signs session cookies, the cookie cache and signed artifact URLs.
# Generate with: openssl rand -hex 32
# Required in production; development falls back to an insecure fixed value.
BETTER_AUTH_SECRET=

# First superadmin, created by `pnpm db:seed`.
# The password is generated and printed once when left empty.
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=
# SEED_SUPERADMIN_NAME=Superadmin
# SEED_TEAM_SLUG=default
# SEED_PROJECT_SLUG=default

# Invitation links expire after this many hours (default 168 = 7 days).
# INVITATION_TTL_HOURS=168

# Lifetime of the signed artifact URLs handed to trace.playwright.dev.
# ARTIFACT_URL_TTL_SECONDS=3600

# Artifact storage: local | vercel-blob
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# BLOB_READ_WRITE_TOKEN=

# Integration tests (pnpm test:integration). Leave unset to let Testcontainers
# start a throwaway postgres:17-alpine; set it to point at your own server
# instead. It must NOT be the same database as DATABASE_URL: the suite creates,
# truncates and drops databases on whatever it is given.
# TEST_DATABASE_URL=postgres://postgres:test@localhost:54329/postgres
# TEST_POSTGRES_IMAGE=postgres:17-alpine
