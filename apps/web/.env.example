# Postgres (pooled URL for the app, direct URL for migrations)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# Public URL of this app. Used for run links, trace-viewer URLs and as Better
# Auth's baseURL (cookies and CSRF), so it must be the real public origin.
# On Vercel it may be left unset: production then uses the project's production
# domain and previews use their deployment URL.
BASE_URL=http://localhost:3000
# Further origins allowed to sign in (comma-separated), e.g. extra domain aliases.
# The deployment's own Vercel URLs are trusted automatically.
# TRUSTED_ORIGINS=https://reports.example.com

# Signs session cookies, the cookie cache and signed artifact URLs.
# Generate with: openssl rand -hex 32
# Required in production; development falls back to an insecure fixed value.
BETTER_AUTH_SECRET=

# First superadmin, created by `pnpm db:seed`.
# The password is generated and printed once when left empty.
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=
# SEED_SUPERADMIN_NAME=Superadmin
# SEED_TEAM_SLUG=default
# SEED_PROJECT_SLUG=default
# Optional read-only demo member of the seeded team.
# SEED_VIEWER_EMAIL=viewer@example.com
# SEED_VIEWER_PASSWORD=

# Public demo: `/demo` signs visitors in, without a password, as this account.
# It must be a plain user who is a viewer in every team it belongs to, or
# `/demo` answers 404. It cannot change its name, password or sessions.
# DEMO_USER_EMAIL=viewer@example.com
# Where `/demo` lands (a path on this app); `/` when unset.
# DEMO_LANDING_PATH=/teams/acme/projects/web-shop/dashboard

# Invitation links expire after this many hours (default 168 = 7 days).
# INVITATION_TTL_HOURS=168

# Lifetime of the signed artifact URLs handed to trace.playwright.dev.
# ARTIFACT_URL_TTL_SECONDS=3600

# Artifact storage: local | vercel-blob
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
# BLOB_READ_WRITE_TOKEN=

# Artifact retention (Administration → Storage). Off until a superadmin turns
# it on; this sets a default lifetime in days until a policy is saved there.
# ARTIFACT_RETENTION_DAYS=30
# Authorizes GET /api/cron/artifact-retention: Vercel Cron sends it as a
# bearer token daily; self-hosted, call the endpoint from any scheduler.
# Without it the endpoint refuses every call. Generate with: openssl rand -hex 32
# CRON_SECRET=
# A finished run starts a sweep when none ran for 12 hours, so retention works
# without a scheduler. `off` leaves it to the cron. Never on Vercel previews.
# ARTIFACT_RETENTION_INGEST_SWEEP=on

# Largest ingest request body in bytes (default 4 MB).
# INGEST_MAX_BATCH_BYTES=4194304

# A run that has not heard from its reporter for this long is closed as
# "Abandoned" (default 5 minutes, clamped to 1–60). A project can override it
# with `settings.staleTimeoutMs`. Reporters send a heartbeat every 30 seconds.
# RUN_STALE_TIMEOUT_MS=300000

# What records abandoned runs: workflow | none. `workflow` guards every running
# run with a Workflow SDK watchdog; `none` only derives the status on read (no
# `run.finished` event, results stay open). Default: `workflow`, except on
# Vercel previews, which share the production database.
# RUN_WATCHDOG_DRIVER=workflow

# Workflow SDK backend. Vercel picks its own and `next dev` a local one under
# .next/workflow-data. Self-hosted (Docker, k8s) set the Postgres world, with a
# direct connection (LISTEN/NOTIFY does not pass PgBouncer's transaction mode),
# and run `npx --package=@workflow/world-postgres bootstrap` once per database.
# WORKFLOW_TARGET_WORLD=@workflow/world-postgres
# WORKFLOW_POSTGRES_URL=postgres://user:pass@host/db?sslmode=require

# Integration tests (pnpm test:integration). Leave unset to let Testcontainers
# start a throwaway postgres:17-alpine; set it to point at your own server
# instead. It must NOT be the same database as DATABASE_URL: the suite creates,
# truncates and drops databases on whatever it is given.
# TEST_DATABASE_URL=postgres://postgres:test@localhost:54329/postgres
# TEST_POSTGRES_IMAGE=postgres:17-alpine

# Browser push notifications when a run starts or finishes. Both keys are
# needed; without them the account page offers no notifications. Generate a
# pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact push services may use about this sender: mailto: or https: URL.
# Defaults to BASE_URL when that is https.
# VAPID_SUBJECT=mailto:ops@example.com
