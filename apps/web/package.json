{
  "name": "@miguelfranken/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-trace-viewer.mjs && next dev --turbopack",
    "build": "node scripts/copy-trace-viewer.mjs && next build",
    "start": "next start",
    "check-types": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --project workflow",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit",
    "db:seed": "nub lib/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "api:docs": "DATABASE_URL=${DATABASE_URL:-postgres://docs@localhost/docs} NODE_OPTIONS=--conditions=react-server nub scripts/gen-openapi.ts",
    "mcp:docs": "DATABASE_URL=${DATABASE_URL:-postgres://docs@localhost/docs} NODE_OPTIONS=--conditions=react-server nub scripts/gen-mcp-docs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@aws-sdk/lib-storage": "^3.1139.0",
    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@miguelfranken/protocol": "workspace:*",
    "@miguelfranken/ui": "workspace:*",
    "@modelcontextprotocol/server": "~2.1.0",
    "@orpc/client": "2.0.0-beta.40",
    "@orpc/json-schema": "2.0.0-beta.40",
    "@orpc/openapi": "2.0.0-beta.40",
    "@orpc/server": "2.0.0-beta.40",
    "@orpc/tanstack-query": "2.0.0-beta.40",
    "@orpc/zod": "2.0.0-beta.40",
    "@tanstack/react-query": "5.103.2",
    "@vercel/blob": "^2.8.0",
    "@workflow/world-postgres": "^4.3.7",
    "better-auth": "1.7.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "web-push": "^3.6.7",
    "workflow": "^4.8.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@miguelfranken/typescript-config": "workspace:*",
    "@modelcontextprotocol/client": "~2.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query-devtools": "5.103.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "@workflow/vitest": "^4.0.25",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.10",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "testcontainers": "^12.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
