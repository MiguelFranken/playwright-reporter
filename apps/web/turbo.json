{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": [
        "BASE_URL",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "STORAGE_DRIVER",
        "STORAGE_LOCAL_DIR",
        "BLOB_READ_WRITE_TOKEN",
        "BETTER_AUTH_SECRET",
        "AUTH_SECRET",
        "INVITATION_TTL_HOURS",
        "ARTIFACT_URL_TTL_SECONDS",
        "VERCEL_ENV",
        "VERCEL_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_BRANCH_URL",
        "TRUSTED_ORIGINS",
        "RUN_STALE_TIMEOUT_MS",
        "RUN_WATCHDOG_DRIVER",
        "WORKFLOW_TARGET_WORLD",
        "WORKFLOW_POSTGRES_URL"
      ]
    },
    "check-types": { "outputs": ["*.tsbuildinfo"] }
  }
}
