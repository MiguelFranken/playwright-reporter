{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "env": [
        "BASE_URL",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "STORAGE_DRIVER",
        "STORAGE_LOCAL_DIR",
        "BLOB_READ_WRITE_TOKEN",
        "BETTER_AUTH_SECRET",
        "AUTH_SECRET",
        "INVITATION_TTL_HOURS",
        "ARTIFACT_URL_TTL_SECONDS",
        "VERCEL_ENV",
        "VERCEL_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_BRANCH_URL",
        "TRUSTED_ORIGINS",
        "RUN_STALE_TIMEOUT_MS",
        "RUN_WATCHDOG_DRIVER",
        "WORKFLOW_TARGET_WORLD",
        "WORKFLOW_POSTGRES_URL",
        "MCP_ENABLED",
        "MCP_DEFAULT_TOOLSETS",
        "MCP_RESPONSE_BUDGET_CHARS",
        "MCP_RATE_LIMIT_PER_MINUTE",
        "MCP_ARTIFACT_URL_TTL_SECONDS",
        "MCP_INLINE_IMAGE_MAX_BYTES",
        "MCP_ALLOWED_HOSTS",
        "PAT_DEFAULT_TTL_DAYS",
        "PAT_MAX_TTL_DAYS"
      ]
    },
    "check-types": { "outputs": ["*.tsbuildinfo"] }
  }
}
