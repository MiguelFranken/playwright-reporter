# Shared with apps/web — copy the same values from apps/web/.env.local
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# Website only
BASE_URL=http://localhost:3001                 # Payload serverURL, live preview, sitemap, OG URLs
PAYLOAD_SECRET=                                # openssl rand -hex 32; different from BETTER_AUTH_SECRET
PAYLOAD_SCHEMA=website                         # Postgres schema for all Payload tables
PREVIEW_SECRET=                                # protects /next/preview; openssl rand -hex 16

# Media storage: a PUBLIC Vercel Blob store, separate from the reporter's private artifact store.
# Leave empty in development to store uploads on disk under .media/.
WEBSITE_BLOB_READ_WRITE_TOKEN=

# First CMS admin, created by `pnpm --filter @repo/website db:seed`
SEED_WEBSITE_ADMIN_EMAIL=admin@example.com
SEED_WEBSITE_ADMIN_PASSWORD=                   # generated and printed once when empty
