    "@payloadcms/storage-vercel-blob": "3.89.0",
    "@miguelfranken/ui": "workspace:*",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "payload": "3.89.0",
