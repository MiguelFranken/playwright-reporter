{
  "name": "@miguelfranken/protocol",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Ingest protocol schemas shared by the Playwright reporter and the web app",
  "files": ["dist"],
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": { "zod": "^4.6.5" },
  "devDependencies": {
    "@miguelfranken/typescript-config": "workspace:*",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
